<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        android:title="@string/vkall_mod_settings_title"
        android:key="vkall_mod_category"
        app:layout="@layout/item_preference_category">
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/vkall_encryption_title"
            android:summary="@string/vkall_encryption_summary"
            android:key="vkall_encryption"
            android:icon="@drawable/vk_icon_lock_outline_28" />
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/vkall_ads_title"
            android:summary="@string/vkall_ads_summary"
            android:key="vkall_ads"
            android:icon="@drawable/vk_icon_advertising_outline_28" />
        <Preference
            android:layout="@layout/item_preference"
            android:title="@string/vkall_privacy_title"
            android:summary="@string/vkall_privacy_summary"
            android:key="vkall_privacy"
            android:icon="@drawable/vk_icon_privacy_outline_28" />
    </PreferenceCategory>
</PreferenceScreen>
